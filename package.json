{
  "name": "nodestro-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace of the brand-neutral UI packages. Not a package itself.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:check": "node scripts/pack.mjs --check",
    "pack:manifest": "node scripts/pack.mjs --write-manifest",
    "mapping": "node scripts/mapping.mjs --write",
    "mapping:check": "node scripts/mapping.mjs --check",
    "test": "npm run test:node && npm run test:components",
    "test:node": "node --test \"packages/*/test/*.test.mjs\" \"test/*.test.mjs\"",
    "test:components": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.mjs",
    "api": "node scripts/api.mjs --write",
    "api:check": "node scripts/api.mjs --check"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "jsdom": "31.0.1",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
