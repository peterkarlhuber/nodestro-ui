      "values": { "light": "#fcefd2", "dark": "#2e240d" }
    },
    "color-diff-removed": {
      "type": "color",
      "description": "Background of removed lines, rows or values.",
      "values": { "light": "#fbe6e8", "dark": "#36161c" }
    },
    "color-nav-bg": {
      "type": "color",
      "description": "Main navigation (sidebar). A brand may make it dark in both themes.",
      "values": { "light": "#eef0f3", "dark": "#13161b" }
    },
    "color-nav-bg-elevated": {
      "type": "color",
      "description": "Raised area inside the navigation: account switcher, flyouts.",
      "values": { "light": "#e4e7ec", "dark": "#1e222a" }
    },
    "color-nav-text": {
      "type": "color",
      "description": "Navigation items.",
      "values": { "light": "#2c313b", "dark": "#c9cdd6" }
    },
    "color-nav-text-muted": {
      "type": "color",
      "description": "Navigation group labels and secondary items.",
      "values": { "light": "#4f5561", "dark": "#a2a8b5" }
    },
    "color-nav-text-active": {
      "type": "color",
      "description": "The current navigation item.",
      "values": { "light": "#0d0f14", "dark": "#ffffff" }
    },
    "color-nav-indicator": {
      "type": "color",
      "description": "Marker of the current navigation item (3:1 against the navigation).",
      "values": { "light": "#2f5bd3", "dark": "#8fb0ff" }
    },
    "color-nav-hover": {
      "type": "color",
      "description": "Hover background of navigation items. Translucent.",
      "values": { "light": "rgba(15, 18, 25, 0.06)", "dark": "rgba(255, 255, 255, 0.06)" }
    },
    "color-nav-active": {
      "type": "color",
      "description": "Background of the current navigation item. Translucent.",
      "values": { "light": "rgba(47, 91, 211, 0.12)", "dark": "rgba(143, 176, 255, 0.14)" }
    },
    "color-nav-border": {
      "type": "color",
      "description": "Divider between the navigation and the content. Translucent.",
      "values": { "light": "rgba(15, 18, 25, 0.08)", "dark": "rgba(255, 255, 255, 0.08)" }
    },
    "shadow-sm": {
      "type": "shadow",
      "description": "Buttons and small raised elements.",
      "values": {
        "light": "0 1px 2px rgba(15, 18, 25, 0.06), 0 1px 1px rgba(15, 18, 25, 0.04)",
        "dark": "0 1px 2px rgba(0, 0, 0, 0.4)"
      }
    },
    "shadow-md": {
      "type": "shadow",
      "description": "Cards, menus and nodes on a canvas.",
      "values": {
        "light": "0 4px 12px rgba(15, 18, 25, 0.08), 0 1px 3px rgba(15, 18, 25, 0.06)",
        "dark": "0 4px 14px rgba(0, 0, 0, 0.45)"
      }
    },
    "shadow-lg": {
      "type": "shadow",
      "description": "Dialogs, popovers and toasts.",
      "values": {
        "light": "0 16px 40px rgba(15, 18, 25, 0.16), 0 4px 12px rgba(15, 18, 25, 0.08)",
        "dark": "0 18px 44px rgba(0, 0, 0, 0.55)"
      }
    }
  }
}
