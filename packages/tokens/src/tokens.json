{
  "prefix": "ui",
  "themes": ["light", "dark"],
  "defaultTheme": "light",
  "tokens": {
    "font-sans": {
      "type": "fontFamily",
      "description": "Interface text. System fonts only: the package bundles no font files.",
      "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "font-display": {
      "type": "fontFamily",
      "description": "Headings and display text. Defaults to the interface font.",
      "value": "var(--ui-font-sans)"
    },
    "font-mono": {
      "type": "fontFamily",
      "description": "Code, identifiers and tabular values.",
      "value": "ui-monospace, 'SFMono-Regular', Menlo, Monaco, Consolas, 'Liberation Mono', monospace"
    },
    "text-2xs": { "type": "dimension", "description": "Font size 10px: dense badges and counters.", "value": "0.625rem" },
    "text-xs": { "type": "dimension", "description": "Font size 12px: captions, labels, table meta.", "value": "0.75rem" },
    "text-sm": { "type": "dimension", "description": "Font size 13px: dense body text and controls.", "value": "0.8125rem" },
    "text-md": { "type": "dimension", "description": "Font size 14px: body text.", "value": "0.875rem" },
    "text-lg": { "type": "dimension", "description": "Font size 16px: emphasized body, small headings.", "value": "1rem" },
    "text-xl": { "type": "dimension", "description": "Font size 20px: section headings.", "value": "1.25rem" },
    "text-2xl": { "type": "dimension", "description": "Font size 24px: page headings.", "value": "1.5rem" },
    "text-3xl": { "type": "dimension", "description": "Font size 30px: display headings.", "value": "1.875rem" },
    "leading-tight": { "type": "number", "description": "Line height for headings and single-line controls.", "value": "1.25" },
    "leading-normal": { "type": "number", "description": "Line height for running text.", "value": "1.5" },
    "weight-regular": { "type": "fontWeight", "description": "Regular text.", "value": "400" },
    "weight-medium": { "type": "fontWeight", "description": "Labels and controls.", "value": "500" },
    "weight-semibold": { "type": "fontWeight", "description": "Headings and emphasized labels.", "value": "600" },
    "weight-bold": { "type": "fontWeight", "description": "Strong emphasis.", "value": "700" },
    "space-0": { "type": "dimension", "description": "No space.", "value": "0" },
    "space-1": { "type": "dimension", "description": "4px.", "value": "0.25rem" },
    "space-2": { "type": "dimension", "description": "8px.", "value": "0.5rem" },
    "space-3": { "type": "dimension", "description": "12px.", "value": "0.75rem" },
    "space-4": { "type": "dimension", "description": "16px.", "value": "1rem" },
    "space-5": { "type": "dimension", "description": "20px.", "value": "1.25rem" },
    "space-6": { "type": "dimension", "description": "24px.", "value": "1.5rem" },
    "space-8": { "type": "dimension", "description": "32px.", "value": "2rem" },
    "space-10": { "type": "dimension", "description": "40px.", "value": "2.5rem" },
    "space-12": { "type": "dimension", "description": "48px.", "value": "3rem" },
    "space-16": { "type": "dimension", "description": "64px.", "value": "4rem" },
    "radius-xs": { "type": "dimension", "description": "Tags, small chips, checkboxes.", "value": "4px" },
    "radius-sm": { "type": "dimension", "description": "Buttons, inputs and other controls.", "value": "6px" },
    "radius-md": { "type": "dimension", "description": "Menus, popovers, small cards.", "value": "8px" },
    "radius-lg": { "type": "dimension", "description": "Cards and panels.", "value": "12px" },
    "radius-xl": { "type": "dimension", "description": "Dialogs and large containers.", "value": "16px" },
    "radius-full": { "type": "dimension", "description": "Pills and round elements.", "value": "999px" },
    "duration-fast": {
      "type": "duration",
      "description": "Hover and focus feedback. 0ms with prefers-reduced-motion.",
      "value": "120ms",
      "reducedMotion": "0ms"
    },
    "duration-normal": {
      "type": "duration",
      "description": "Opening and closing panels, menus and toasts. 0ms with prefers-reduced-motion.",
      "value": "200ms",
      "reducedMotion": "0ms"
    },
    "duration-slow": {
      "type": "duration",
      "description": "Large layout changes. 0ms with prefers-reduced-motion.",
      "value": "320ms",
      "reducedMotion": "0ms"
    },
    "ease-standard": { "type": "cubicBezier", "description": "Default easing.", "value": "cubic-bezier(0.2, 0, 0, 1)" },
    "ease-emphasized": { "type": "cubicBezier", "description": "Easing with a slight overshoot for entering elements.", "value": "cubic-bezier(0.3, 0, 0, 1.2)" },
    "z-sticky": { "type": "number", "description": "Sticky headers and toolbars.", "value": "10" },
    "z-drawer": { "type": "number", "description": "Drawers and side sheets.", "value": "40" },
    "z-overlay": { "type": "number", "description": "Modal dialogs and their backdrop.", "value": "50" },
    "z-toast": { "type": "number", "description": "Toasts.", "value": "60" },
    "z-tooltip": { "type": "number", "description": "Tooltips, above everything else.", "value": "70" },
    "control-height": { "type": "dimension", "description": "Height of buttons, inputs and selects.", "value": "2rem" },
    "row-height": { "type": "dimension", "description": "Height of list and table rows.", "value": "2rem" },

    "color-bg": {
      "type": "color",
      "description": "Page background behind surfaces.",
      "values": { "light": "#f5f6f8", "dark": "#0f1115" }
    },
    "color-surface": {
      "type": "color",
      "description": "Default surface: cards, inputs, dialogs.",
      "values": { "light": "#ffffff", "dark": "#171a20" }
    },
    "color-surface-2": {
      "type": "color",
      "description": "Secondary surface: side panels, table headers, inset areas.",
      "values": { "light": "#eef0f3", "dark": "#1e222a" }
    },
    "color-surface-raised": {
      "type": "color",
      "description": "Surface that sits above another surface: popovers, floating toolbars.",
      "values": { "light": "#fafbfc", "dark": "#242933" }
    },
    "color-surface-hover": {
      "type": "color",
      "description": "Hover state of surfaces, rows and quiet buttons.",
      "values": { "light": "#e9ebef", "dark": "#272c36" }
    },
    "color-chrome": {
      "type": "color",
      "description": "Application frame: top bar, status bar, activity bar.",
      "values": { "light": "#ffffff", "dark": "#13161b" }
    },
    "color-canvas": {
      "type": "color",
      "description": "Background of editors and diagram canvases.",
      "values": { "light": "#eef0f3", "dark": "#14171c" }
    },
    "color-grid": {
      "type": "color",
      "description": "Grid dots and lines on a canvas. Translucent.",
      "values": { "light": "rgba(60, 70, 90, 0.12)", "dark": "rgba(200, 210, 230, 0.08)" }
    },
    "color-overlay": {
      "type": "color",
      "description": "Backdrop behind modal dialogs. Translucent.",
      "values": { "light": "rgba(15, 18, 25, 0.45)", "dark": "rgba(0, 0, 0, 0.62)" }
    },
    "color-border": {
      "type": "color",
      "description": "Decorative borders and dividers (no contrast requirement).",
      "values": { "light": "#dde0e6", "dark": "#2b3039" }
    },
    "color-border-strong": {
      "type": "color",
      "description": "Stronger dividers and outlines of raised elements.",
      "values": { "light": "#c4c9d2", "dark": "#3d434f" }
    },
    "color-control-border": {
      "type": "color",
      "description": "Border of inputs, checkboxes and other controls (3:1 against surfaces).",
      "values": { "light": "#7c8391", "dark": "#7a8190" }
    },
    "color-text": {
      "type": "color",
      "description": "Body text.",
      "values": { "light": "#171a21", "dark": "#e7e9ee" }
    },
    "color-text-muted": {
      "type": "color",
      "description": "Secondary text: descriptions, labels, metadata.",
      "values": { "light": "#4a505c", "dark": "#a9afbb" }
    },
    "color-text-subtle": {
      "type": "color",
      "description": "Tertiary text: placeholders, hints, empty values. Still 4.5:1.",
      "values": { "light": "#5c6370", "dark": "#959cab" }
    },
    "color-heading": {
      "type": "color",
      "description": "Headings.",
      "values": { "light": "#0d0f14", "dark": "#f5f6f8" }
    },
    "color-primary": {
      "type": "color",
      "description": "Primary action color: filled buttons, selected controls.",
      "values": { "light": "#2f5bd3", "dark": "#8fb0ff" }
    },
    "color-primary-hover": {
      "type": "color",
      "description": "Hover state of the primary color.",
      "values": { "light": "#244ab2", "dark": "#adc4ff" }
    },
    "color-primary-active": {
      "type": "color",
      "description": "Pressed state of the primary color.",
      "values": { "light": "#1d3c91", "dark": "#7397f0" }
    },
    "color-primary-subtle": {
      "type": "color",
      "description": "Quiet primary background: selected rows, primary badges.",
      "values": { "light": "#e7edfc", "dark": "#1d2a4d" }
    },
    "color-on-primary": {
      "type": "color",
      "description": "Text and icons on the primary color.",
      "values": { "light": "#ffffff", "dark": "#0f1115" }
    },
    "color-accent": {
      "type": "color",
      "description": "Secondary highlight for decoration and charts, not for text.",
      "values": { "light": "#6b46d9", "dark": "#b29cff" }
    },
    "color-focus": {
      "type": "color",
      "description": "Focus ring (3:1 against the background and surfaces).",
      "values": { "light": "#2f5bd3", "dark": "#8fb0ff" }
    },
    "color-link": {
      "type": "color",
      "description": "Links in running text.",
      "values": { "light": "#2753c9", "dark": "#9cb8ff" }
    },
    "color-selected": {
      "type": "color",
      "description": "Background of selected rows, items and tabs.",
      "values": { "light": "#e7edfc", "dark": "#1d2a4d" }
    },
    "color-success": {
      "type": "color",
      "description": "Success text and icons.",
      "values": { "light": "#156b45", "dark": "#5ad69c" }
    },
    "color-success-bg": {
      "type": "color",
      "description": "Background of success badges and alerts.",
      "values": { "light": "#e3f3ea", "dark": "#10281e" }
    },
    "color-warning": {
      "type": "color",
      "description": "Warning text and icons.",
      "values": { "light": "#7d4b00", "dark": "#f2c35c" }
    },
    "color-warning-bg": {
      "type": "color",
      "description": "Background of warning badges and alerts.",
      "values": { "light": "#fcefd2", "dark": "#2e240d" }
    },
    "color-danger": {
      "type": "color",
      "description": "Errors and destructive actions: text, icons, filled buttons.",
      "values": { "light": "#b42334", "dark": "#ff8a94" }
    },
    "color-danger-hover": {
      "type": "color",
      "description": "Hover state of filled destructive buttons.",
      "values": { "light": "#951c2a", "dark": "#ffa6ad" }
    },
    "color-danger-bg": {
      "type": "color",
      "description": "Background of error badges and alerts.",
      "values": { "light": "#fbe6e8", "dark": "#36161c" }
    },
    "color-on-danger": {
      "type": "color",
      "description": "Text and icons on the danger color.",
      "values": { "light": "#ffffff", "dark": "#0f1115" }
    },
    "color-info": {
      "type": "color",
      "description": "Informational text and icons.",
      "values": { "light": "#0b5f95", "dark": "#6cc6f0" }
    },
    "color-info-bg": {
      "type": "color",
      "description": "Background of informational badges and alerts.",
      "values": { "light": "#e1eff9", "dark": "#0f2635" }
    },
    "color-running": {
      "type": "color",
      "description": "Status: in progress (runs, jobs, streaming answers).",
      "values": { "light": "#0d6470", "dark": "#5fd0dc" }
    },
    "color-running-bg": {
      "type": "color",
      "description": "Background of in-progress badges.",
      "values": { "light": "#ddf2f4", "dark": "#0d2a2e" }
    },
    "color-idle": {
      "type": "color",
      "description": "Status: idle, queued, not started.",
      "values": { "light": "#565d69", "dark": "#a9afbb" }
    },
    "color-idle-bg": {
      "type": "color",
      "description": "Background of idle badges.",
      "values": { "light": "#eceef2", "dark": "#262b34" }
    },
    "color-neutral": {
      "type": "color",
      "description": "Neutral badges and tags without a status meaning.",
      "values": { "light": "#4a505c", "dark": "#a9afbb" }
    },
    "color-neutral-bg": {
      "type": "color",
      "description": "Background of neutral badges and tags.",
      "values": { "light": "#eef0f3", "dark": "#262b34" }
    },
    "color-code-bg": {
      "type": "color",
      "description": "Background of code blocks and inline code.",
      "values": { "light": "#f0f2f5", "dark": "#13161b" }
    },
    "color-skeleton": {
      "type": "color",
