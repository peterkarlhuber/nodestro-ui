{
  "name": "@nodestro/ui-core",
  "version": "0.2.3",
  "private": true,
  "description": "Brand-neutral, accessible React building blocks: buttons, fields, dialogs, list and detail, collapsible sections, tooltips, context help and offline help search.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterkarlhuber/nodestro-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "peerDependencies": {
    "@nodestro/ui-tokens": "^0.1.0",
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
