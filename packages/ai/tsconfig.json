{
  // For editors only: the package build uses the options in scripts/lib/react-package.mjs.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": "../..",
    "paths": {
      "@nodestro/ui-core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["src"]
}
