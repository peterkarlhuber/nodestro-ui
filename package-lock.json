{
  "name": "nodestro-ui-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nodestro-ui-workspace",
      "version": "0.0.0",
      "license": "SEE LICENSE IN LICENSE",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.12"
      }
    },
    "node_modules/@nodestro/ui-tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "packages/tokens": {
      "name": "@nodestro/ui-tokens",
      "version": "0.1.0",
      "license": "SEE LICENSE IN LICENSE",
      "engines": {
        "node": ">=22.12"
      }
    }
  }
}
